# Configuración de ejemplo para el Agente RAG de DNI
# Copia este fichero a .env y ajusta los valores si fuera necesario.
# No incluyas claves reales ni subas el archivo .env al repositorio.

# --- Ollama local: obligatorio para la práctica ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
VERIFY_SSL=true

# --- Vector store ---
CHROMA_PATH=./data/chroma
COLLECTION_NAME=dni

# --- API opcional ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Corpus oficial DNI ---
CORPUS_DIR=./corpus

# Para usar PoliGPT, cambia LLM_PROVIDER=poligpt en tu archivo .env privado.
# POLIGPT_BASE_URL=https://api.poligpt.upv.es/v1
# POLIGPT_API_KEY=tu_clave_privada_aqui
# POLIGPT_MODEL=poligpt