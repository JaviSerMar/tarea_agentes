# Configuración de ejemplo para el Agente RAG DNI
# Copia este fichero a .env y ajusta los valores necesarios.
# Nunca incluyas claves reales ni subas el archivo .env al repositorio.

# ============================================================
# Configuración final recomendada: modelo local seleccionado
# ============================================================

# Proveedor y modelo generativo
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434/api

# Embeddings utilizados por el agente
EMBEDDER_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Vector store utilizado en la configuración final
VECTOR_STORE_PROVIDER=faiss
FAISS_PATH=./data/dni.index

# Corpus oficial DNI
CORPUS_DIR=./base_conocimiento

# Configuración general
VERIFY_SSL=true

# ============================================================
# Alternativas implementadas mediante adapters hexagonales
# ============================================================

# Embeddings alternativos:
# EMBEDDER_PROVIDER=sentence_transformers
# SENTENCE_TRANSFORMERS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store alternativo:
# VECTOR_STORE_PROVIDER=chroma
# CHROMA_PATH=./data/chroma
# COLLECTION_NAME=dni

# ============================================================
# PoliGPT: alternativa remota y evaluación RAGAs
# ============================================================

# Requiere VPN UPV cuando se trabaja fuera del campus.
# No escribas nunca una clave real en este archivo de ejemplo.
# Para usar PoliGPT como LLM generativo en tu .env privado:
#
# LLM_PROVIDER=poligpt
# POLIGPT_BASE_URL=https://api.poligpt.upv.es/v1
# POLIGPT_API_KEY=tu_clave_privada_aqui
# POLIGPT_MODEL=gemma3:27b

# ============================================================
# API opcional incluida en el repositorio
# ============================================================

API_HOST=127.0.0.1
API_PORT=8000